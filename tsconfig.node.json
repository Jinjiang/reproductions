{
  "compilerOptions": {
    "composite": true,

    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],

    "skipLibCheck": true,
    "noEmit": true,

    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/node.tsbuildinfo",
  },
  "include": ["vite.config.ts"]
}
