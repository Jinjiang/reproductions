{
  "name": "reproduce",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run compile:watch",
    "build": "pnpm run compile && pnpm run types",
    "test": "vitest",
    "preview": "vite preview",
    "compile": "node scripts/compile.mjs",
    "compile:watch": "node scripts/compile.mjs --watch",
    "types": "tsc --declaration --emitDeclarationOnly --outDir dist"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/ui": "^1.1.0",
    "@vue/test-utils": "^2.4.1",
    "happy-dom": "^12.10.3",
    "tsc-vue": "^2.0.3",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.7",
    "vitest": "^1.1.0",
    "vitest-dom": "^0.1.1",
    "vue-simple-compiler": "^0.0.7",
    "vue-tsc": "^3.2.1"
  }
}
