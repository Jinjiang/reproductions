{
  "name": "my-comp",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "rm -rf dist",
    "dev": "pnpm run compile:watch",
    "build": "pnpm run compile && pnpm run types",
